rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/notes/{noteId} {
      allow read, write: if owner(uid);
    }
    // La cuenta asociada a Drive solo se puede registrar una vez por usuario.
    // El administrador de Firebase puede resolver recuperaciones fuera de la app.
    match /users/{uid}/settings/drive {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+$');
      allow update, delete: if false;
    }
    match /users/{uid}/settings/{settingId} {
      allow read, write: if owner(uid) && settingId != 'drive';
    }
    match /profiles/{uid} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','preferences','createdAt']);
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','preferences']);
    }

    // Cada persona registra solo sus propios accesos.
    // El administrador puede consultar los contadores de todos los usuarios.
    function accessAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }
    function validAccessStats() {
      return request.resource.data.keys().hasOnly(['email','displayName','accessCount','lastAccess'])
        && request.resource.data.keys().hasAll(['email','displayName','accessCount','lastAccess'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.accessCount is int
        && request.resource.data.lastAccess == request.time;
    }
    match /accessStats/{uid} {
      allow get: if owner(uid) || accessAdmin();
      allow list: if accessAdmin();
      allow create: if owner(uid) && validAccessStats()
        && request.resource.data.accessCount == 1;
      allow update: if owner(uid) && validAccessStats()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName','accessCount','lastAccess'])
        && request.resource.data.accessCount == resource.data.accessCount + 1;
      allow delete: if false;
    }
    // Registro de aperturas de carpetas y documentos por persona.
    // Cada usuario escribe solo su actividad; el administrador puede consultar todos.
    function validLibraryVisit(visitId) {
      return request.resource.data.keys().hasOnly(['kind','itemId','name','path','visitCount','lastVisited'])
        && request.resource.data.keys().hasAll(['kind','itemId','name','path','visitCount','lastVisited'])
        && request.resource.data.kind in ['folder','file']
        && request.resource.data.itemId is string
        && request.resource.data.itemId.matches('^[A-Za-z0-9_-]{1,160}$')
        && visitId == request.resource.data.kind + '_' + request.resource.data.itemId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 600
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount >= 1
        && request.resource.data.lastVisited == request.time;
    }
    match /users/{uid}/libraryVisits/{visitId} {
      allow get, list: if owner(uid) || accessAdmin();
      allow create: if owner(uid) && validLibraryVisit(visitId)
        && request.resource.data.visitCount == 1;
      allow update: if owner(uid) && validLibraryVisit(visitId)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','path','visitCount','lastVisited'])
        && request.resource.data.visitCount == resource.data.visitCount + 1;
      allow delete: if false;
    }

    // Tablón compartido: lectura y publicación para cuentas verificadas.
    match /commonMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['authorId','authorName','text','createdAt'])
        && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Cada dispositivo puede ser registrado y desregistrado solo por su titular.
    match /users/{uid}/pushDevices/{deviceId} {
      allow get, list, delete: if owner(uid);
      allow create, update: if owner(uid)
        && deviceId.size() == 64
        && request.resource.data.keys().hasAll(['token','platform','updatedAt'])
        && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 10
        && request.resource.data.token.size() <= 2048
        && request.resource.data.platform == 'web'
        && request.resource.data.updatedAt == request.time;
    }
    match /roles/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
  }
}
