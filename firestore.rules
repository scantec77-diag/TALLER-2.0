rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/notes/{noteId} {
      allow read, write: if owner(uid);
    }
    // La cuenta asociada a Drive solo se puede registrar una vez por usuario.
    // El administrador de Firebase puede resolver recuperaciones fuera de la app.
    match /users/{uid}/settings/drive {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+$');
      allow update, delete: if false;
    }
    match /users/{uid}/settings/{settingId} {
      allow read, write: if owner(uid) && settingId != 'drive';
    }
    match /profiles/{uid} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','preferences','createdAt']);
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','preferences']);
    }
    match /roles/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
  }
}
